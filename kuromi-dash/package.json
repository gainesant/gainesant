{
  "name": "kuromi-dash",
  "version": "0.1.0",
  "private": true,
  "description": "Kuromi-themed HTML car control panel with USB Android phone projection",
  "type": "module",
  "scripts": {
    "build": "esbuild src/phone.js --bundle --format=esm --target=chrome110 --minify --outfile=public/vendor/phone.js",
    "fetch-server": "node scripts/fetch-server.mjs",
    "start": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@yume-chan/adb": "^2.6.4",
    "@yume-chan/adb-credential-web": "^2.1.0",
    "@yume-chan/adb-daemon-webusb": "^2.3.2",
    "@yume-chan/adb-scrcpy": "^2.3.2",
    "@yume-chan/scrcpy": "^2.3.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "^2.5.3",
    "@yume-chan/stream-extra": "^2.6.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
